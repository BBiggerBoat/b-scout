{
  "name": "b-scout-public",
  "private": true,
  "version": "6.23.4",
  "description": "B-Scout dual-mode community backend: local filesystem plus Cloudflare D1/KV live persistence",
  "scripts": {
    "test:marketplace-signal": "node developer/test-marketplace-signal.js",
    "validate:marketplaces": "node developer/validate-marketplace-signals.js",
    "generate": "node developer/generate-all.js",
    "test:broker-signal": "node developer/test-broker-adapters.js",
    "generate:search-aliases": "node developer/generate-model-search-aliases.js",
    "start": "node server.js",
    "cf:dev": "wrangler pages dev .",
    "cf:d1:local": "wrangler d1 execute BSCOUT_DB --local --file=cloudflare/schema.sql",
    "generate:search-pages": "python developer/generate-search-landing-pages.py"
  },
  "devDependencies": {
    "playwright": "^1.54.0",
    "wrangler": "^4.0.0"
  }
}
